; Development-only WinUSB binding for Qualcomm Atheros 0cf3:1022.
; Install only during a planned native-driver test window.

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49F0-BC3D-A4FF138216D6}
Provider    = %ProviderName%
DriverVer   = 11/08/2026,0.1.0.0
CatalogFile = ath6kl-winusb.cat

[Manufacturer]
%ProviderName% = DeviceList,NTamd64

[DeviceList.NTamd64]
%DeviceName% = WinUSB_Install, USB\VID_0CF3&PID_1022

[WinUSB_Install.NT]
Include = winusb.inf
Needs   = WINUSB.NT

[WinUSB_Install.NT.Services]
Include    = winusb.inf
AddService = WinUSB,0x00000002,WinUSB_ServiceInstall

[WinUSB_Install.NT.HW]
AddReg = DeviceInterfaceGUIDs

[DeviceInterfaceGUIDs]
HKR,,DeviceInterfaceGUIDs,0x10000,"{B8A8F6EA-9CC8-47DB-A3FA-15C879E2F651}"

[Strings]
ProviderName = "DJI Radar Native"
DeviceName   = "DJI Radar AR6004 WinUSB Transport"
