+"""Bounded, thread-safe timing counters; never hold a lock during device I/O."""
+import threading
+import time
+
+
+class IoMetrics:
+    def __init__(self, clock=time.monotonic):
+        self.clock = clock
+        self.lock = threading.Lock()
+        self.rows = {}
+
+    def begin(self, name):
+        now = self.clock()
+        with self.lock:
+            row = self.rows.setdefault(name, dict(calls=0, errors=0, bytes=0, max_ms=0, last_ms=0, active=None))
+            row['calls'] += 1
+            row['active'] = now
+        return now
+
+    def end(self, name, started, count=0, error=None):
+        elapsed = 1000*(self.clock()-started)
+        with self.lock:
+            row = self.rows[name]
+            row['active'] = None
+            row['last_ms'] = elapsed
+            row['max_ms'] = max(row['max_ms'], elapsed)
+            row['bytes'] += count
+            if error is not None:
+                row['errors'] += 1
+                row['last_error'] = type(error).__name__
+
+    def snapshot(self):
+        now = self.clock()
+        with self.lock:
+            return {name:{**row, 'active_ms':0 if row['active'] is None else 1000*(now-row['active'])}
+                    for name,row in self.rows.items()}
