+import queue
+import unittest
+from unittest.mock import Mock, patch
+import usb1
+from ath6kl_win.io_metrics import IoMetrics
+from ath6kl_win.usb_bulk import UsbBulk
+from ath6kl_win.tap_debug import TapDebug
+
+
+class IoMetricsTests(unittest.TestCase):
+    def test_recovered_stall_is_counted_even_when_outer_call_succeeds(self):
+        handle=Mock();handle.bulkRead.side_effect=[usb1.USBErrorPipe(),b'ok']
+        bulk=UsbBulk(handle)
+        self.assertEqual(bulk(0x82,4096),b'ok')
+        self.assertEqual(bulk.metrics_snapshot()['recovery'],{'pipe_errors':1,'successful_retries':1})
+        self.assertEqual(bulk.metrics_snapshot()['usb_82']['errors'],0)
+
+    def test_active_wait_error_and_success_are_distinguishable(self):
+        now = [10.0]
+        m = IoMetrics(clock=lambda:now[0])
+        start = m.begin('read')
+        now[0] += .2
+        self.assertAlmostEqual(m.snapshot()['read']['active_ms'],200)
+        m.end('read',start,error=TimeoutError())
+        start = m.begin('read')
+        now[0] += .01
+        m.end('read',start,512)
+        result=m.snapshot()['read']
+        self.assertEqual((result['calls'],result['errors'],result['bytes']),(2,1,512))
+        self.assertEqual(result['active_ms'],0)
+        self.assertAlmostEqual(result['max_ms'],200)
+
+    def test_queue_full_is_observable_and_receive_never_blocks(self):
+        tap=TapDebug.__new__(TapDebug)
+        tap.ap_mac=tap.mac=bytes(6);tap.debug_ip=bytes(4);tap.allow_udp=True
+        tap.queue=queue.Queue(maxsize=1)
+        tap.queue_dropped=tap.queue_high_water=0;tap.metrics=IoMetrics()
+        with patch('ath6kl_win.tap_debug.translate',return_value=b'packet'):
+            tap.receive(b'a');tap.receive(b'b')
+        result=tap.metrics_snapshot()
+        self.assertEqual((result['queue_size'],result['queue_high_water'],result['queue_dropped']),(1,1,1))
+
+    def test_usb_failure_keeps_counter_without_replaying_out(self):
+        handle=Mock();handle.bulkWrite.side_effect=usb1.USBErrorPipe()
+        bulk=UsbBulk(handle)
+        with self.assertRaises(usb1.USBErrorPipe):bulk(2,b'command')
+        self.assertEqual(bulk.metrics_snapshot()['usb_02']['errors'],1)
+        self.assertEqual(bulk.metrics_snapshot()['usb_02']['active_ms'],0)
+        handle.bulkWrite.assert_called_once()
